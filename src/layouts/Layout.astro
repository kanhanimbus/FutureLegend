---
import LinksColumn from "../components/LinksColumn.astro"
import SubjectColumn from "../components/SubjectColumn.astro"
---
<!DOCTYPE html>
<html>
	<head>
		<title>Welcome to FutureLegend!</title>
	</head>
	<body>
		<div class = "flex-container">
			<div class = "content-container">
				<LinksColumn/>
				<SubjectColumn>
					<slot/>
				</SubjectColumn>
			</div>
		</div>
	</body>
</html>
<style>
.flex-container {
	display: flex;
	flex-direction: column;
	height: 100vh;
}

.content-container {
    display: flex;
    flex-direction: row;
	height: 100%;
	border: 2px solid black;
	border-radius: 30px;
	background-color: blue;
}



</style>
