---
import '../components/styles.css'
import ExperiComp from "../components/ExperiComp.astro"
import SubjectColumn from '../components/SubjectColumn.astro'
---
<!DOCTYPE html>
<html>
	<head>
		<title>Experimental Page lol</title>
	</head>
	<body>
		<div class = "flex-container">
			<div class = "content-container">
				<ExperiComp/>
				<SubjectColumn>
					experimental page
				</SubjectColumn>
			</div>
		</div>
	</body>
</html>
<style>
.flex-container {
	display: flex;
	flex-direction: column;
	height: 100vh;
}

.content-container {
    display: flex;
    flex-direction: row;
    flex: 9 1 1;
	height: 100%;
}

.subject-column {
    border: 2px solid #630075;
	border-radius: 30px;
    color: #b204d1;
    background-color: black;
    flex: 8 1 0;
}

.logo {
    padding: 30px;
    text-align: center;
    margin: 40px;
    border: 2px solid;
    border-radius: 30px;
}


html {background-color: black}
</style>
