---
import Layout from "../../layouts/Layout.astro"
import ArticleLayout from "../../layouts/ArticleLayout.astro"
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blogInfluences');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout>
  <ArticleLayout>
      <div class = "headingInfluences" slot = "title">
        <span>{post.data.title}
          </span>
      </div>
      <Content slot = "bodyArticle"/>
  </ArticleLayout>
</Layout>

<style>
  .goBack {
        border-radius: 30px;
        background-color: #1b1bad;
        width: 3%;
        aspect-ratio: 1/1;
        cursor: pointer;
        display: block;
        text-align: center;
        border: 2px solid #FFe52c;
        color: #FFe52c
    }
  .headingInfluences {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 50px;
    flex: 1 1 0;
    text-align: center;
  }
  span {
   display: inline-block;
   vertical-align: middle;
   line-height: normal;
  }
</style>