---
import { getCollection, getEntry, render } from "astro:content";
const Logs = await getCollection('blogLogs');
---

<div class="bgColorCont">
    <div class="titleLogs">
      <h1>Logs of things I'm working on</h1>
    </div>
    <div class="articleNames">
      <ul>
      {Logs.map(post => (
      <li><a href={`/logs/${post.id}`} class = "linkLogs">{post.data.title}</a><br>{post.data.description}</li>
      ))}
      </ul>
    </div>
</div>

<style>
  ul {
    list-style-type: none;
  }
  li {
    border-radius: 30px;
    background-color: #ffe52c;
    color: #1b1bad;
    margin-bottom: 5px;
    padding-left: 25px;
    font-size: 15px;
  }
  .linkLogs {
    font-size: 20px;
  }
  .titleLogs {
    border: 2px solid #FFe52c;
        border-radius: 30px;
        display: flex;
        flex-direction: column;
        flex: 1 1 0;
        text-align: center;
        font-size: large;
        background-color: #1b1bad;
  }
  .articleNames {
    padding-left: 16px;
        padding-right: 16px;
        border: 2px solid #ffe52c;
        border-radius: 30px;
        flex-direction: column;
        flex: 9 1 1;
        background-color: #1b1bad;
        overflow: auto;
        font-size: 20px;
  }
  .bgColorCont {
        border-radius: 30px;
        background-color: #ffe52c;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
</style>